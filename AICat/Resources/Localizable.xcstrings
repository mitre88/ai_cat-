    "scenario.1.concept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A computer can follow a rule you give it, or learn the rule from your examples. That second thing is AI!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una computadora puede seguir una regla que le das, o aprender la regla con tus ejemplos. ¡Eso segundo es IA!"
          }
        }
      }
    },
    "scenario.1.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to my garden! Sort the fruits into the baskets and watch me learn the pattern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Bienvenido a mi jardín! Acomoda las frutas en las canastas y mira cómo aprendo el patrón."
          }
        }
      }
    },
    "scenario.1.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is AI? Patterns and rules"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué es la IA? Patrones y reglas"
          }
        }
      }
    },
    "scenario.1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pattern Garden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Jardín de Patrones"
          }
        }
      }
    },
    "scenario.10.concept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generative AI makes new things from patterns it learned. You decide how to use it, and you take the credit!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA generativa crea cosas nuevas a partir de patrones que aprendió. Tú decides cómo usarla, ¡y el mérito es tuyo!"
          }
        }
      }
    },
    "scenario.10.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Final world! Let's create stories and ideas together, then build your own mini AI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Último mundo! Creemos historias e ideas juntos y luego construye tu propia mini IA."
          }
        }
      }
    },
    "scenario.10.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generative AI and your project"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "IA generativa y tu proyecto"
          }
        }
      }
    },
    "scenario.10.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creative Lab"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Laboratorio Creativo"
          }
        }
      }
    },
    "scenario.2.concept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI learns from data. Labels tell it what each example is. More and better data means better guesses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA aprende de datos. Las etiquetas le dicen qué es cada ejemplo. Más y mejores datos, mejores respuestas."
          }
        }
      }
    },
    "scenario.2.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This library is full of animal cards. Label them and I will learn to tell them apart!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta biblioteca está llena de tarjetas de animales. ¡Etiquétalas y aprenderé a distinguirlos!"
          }
        }
      }
    },
    "scenario.2.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data, labels and quality"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos, etiquetas y calidad"
          }
        }
      }
    },
    "scenario.2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data Library"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteca de Datos"
          }
        }
      }
    },
    "scenario.3.concept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A classifier draws a line between groups. Examples on each side teach it where the line goes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clasificador traza una línea entre grupos. Los ejemplos de cada lado le enseñan dónde va la línea."
          }
        }
      }
    },
    "scenario.3.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In my workshop we build a machine that separates things. Put examples on the board!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En mi taller construimos una máquina que separa cosas. ¡Pon ejemplos en el tablero!"
          }
        }
      }
    },
    "scenario.3.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Training a classifier"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrenar un clasificador"
          }
        }
      }
    },
    "scenario.3.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Classifier Workshop"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Taller de Clasificación"
          }
        }
      }
    },
    "scenario.4.concept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An algorithm is a list of clear steps. Computers follow them exactly, even the silly ones."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un algoritmo es una lista de pasos claros. Las computadoras los siguen tal cual, hasta los tontos."
          }
        }
      }
    },
    "scenario.4.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Guide me along the trail with instruction blocks. I only do exactly what you say!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guíame por el sendero con bloques de instrucciones. ¡Solo hago exactamente lo que dices!"
          }
        }
      }
    },
    "scenario.4.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Algorithms: step by step"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algoritmos: paso a paso"
          }
        }
      }
    },
    "scenario.4.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Algorithm Trail"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendero de Instrucciones"
          }
        }
      }
    },
    "scenario.5.concept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some AI learns by trying: good moves earn rewards, bad moves lose them. After many tries it finds the best path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas IA aprenden probando: los buenos movimientos ganan recompensas, los malos las pierden. Tras muchos intentos encuentra el mejor camino."
          }
        }
      }
    },
    "scenario.5.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I don't know this maze. Place treats and let me explore. I'll remember what worked!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No conozco este laberinto. Pon premios y déjame explorar. ¡Recordaré lo que funcionó!"
          }
        }
      }
    },
    "scenario.5.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learning from rewards"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprender con recompensas"
          }
        }
      }
    },
    "scenario.5.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reward Maze"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Laberinto de Recompensas"
          }
        }
      }
    },
    "scenario.6.concept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Artificial neurons add up signals with weights. Many neurons together can learn almost anything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las neuronas artificiales suman señales con pesos. Muchas neuronas juntas pueden aprender casi cualquier cosa."
          }
        }
      }
    },
    "scenario.6.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to the factory where my brain is built! Turn the dials and light the right lamp."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Bienvenido a la fábrica donde se construye mi cerebro! Gira las perillas y enciende la lámpara correcta."
          }
        }
      }
    },
    "scenario.6.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neural networks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Redes neuronales"
          }
        }
      }
    },
    "scenario.6.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuron Factory"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fábrica de Neuronas"
          }
        }
      }
    },
    "scenario.7.concept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To a computer an image is a grid of numbers. Finding edges and shapes in the numbers is how it sees."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para una computadora una imagen es una cuadrícula de números. Encontrar bordes y formas en los números es su forma de ver."
          }
        }
      }
    },
    "scenario.7.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's look through my eyes! Pixels, edges, shapes… and then real objects with your camera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Miremos con mis ojos! Píxeles, bordes, formas… y luego objetos reales con tu cámara."
          }
        }
      }
    },
    "scenario.7.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Computer vision"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Visión por computadora"
          }
        }
      }
    },
    "scenario.7.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI CAT's Eyes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ojos de AI CAT"
          }
        }
      }
    },
    "scenario.8.concept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language models split words into tokens and predict what comes next. That is how I talk!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos de lenguaje parten las palabras en tokens y predicen lo que sigue. ¡Así hablo yo!"
          }
        }
      }
    },
    "scenario.8.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this stage we play with words: tokens, guessing the next word and, finally, talking to me!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En este escenario jugamos con palabras: tokens, adivinar la siguiente palabra y, al final, ¡hablar conmigo!"
          }
        }
      }
    },
    "scenario.8.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Natural language"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lenguaje natural"
          }
        }
      }
    },
    "scenario.8.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI CAT's Voice"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Voz de AI CAT"
          }
        }
      }
    },
    "scenario.9.concept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the data is unfair, the AI is unfair. Good AI needs balanced data, privacy and people who check it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si los datos son injustos, la IA es injusta. Una buena IA necesita datos balanceados, privacidad y personas que la revisen."
          }
        }
      }
    },
    "scenario.9.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something is wrong with this dataset: I only recognise black cats! Help me make it fair."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo anda mal con estos datos: ¡solo reconozco gatos negros! Ayúdame a hacerlos justos."
          }
        }
      }
    },
    "scenario.9.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bias, fairness and privacy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesgo, justicia y privacidad"
          }
        }
      }
    },
