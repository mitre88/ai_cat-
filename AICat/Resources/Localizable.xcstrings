    "parent.privacy_text": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI CAT works entirely on this device. It never connects to the internet, shows no ads, collects no data and asks for no personal information. The kitten's name and the progress are stored only on this device and can be erased above. The camera (world 7) and the microphone (world 8) are used only after a grown-up passes the parental gate; images and speech are analysed on the device and never saved or sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "AI CAT funciona completamente en este dispositivo. Nunca se conecta a internet, no muestra anuncios, no recopila datos ni pide información personal. El nombre del gatito y el progreso se guardan solo en este dispositivo y pueden borrarse arriba. La cámara (mundo 7) y el micrófono (mundo 8) se usan solo después de que un adulto pasa la puerta parental; las imágenes y la voz se analizan en el dispositivo y nunca se guardan ni se envían."
          }
        }
      }
    },
