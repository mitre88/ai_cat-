    "story.s0.v0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once upon a time, %1$@ lived near %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Había una vez %1$@ que vivía cerca de %2$@."
          }
        }
      }
    },
    "story.s0.v1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every morning, %1$@ ran to %2$@ to play."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada mañana, %1$@ corría a %2$@ para jugar."
          }
        }
      }
    },
    "story.s0.v2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody at %2$@ had ever met %1$@, until today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie en %2$@ había conocido a %1$@, hasta hoy."
          }
        }
      }
    },
    "story.s1.v0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One day, %1$@ found %3$@ under a stone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día, %1$@ encontró %3$@ debajo de una piedra."
          }
        }
      }
    },
    "story.s1.v1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suddenly, %3$@ began to glow and hum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De pronto, %3$@ empezó a brillar y a zumbar."
          }
        }
      }
    },
    "story.s1.v2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@ was lost, and %1$@ searched everywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@ se había perdido, y %1$@ buscó por todas partes."
          }
        }
      }
    },
    "story.s2.v0": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the end, %1$@ shared %3$@ with everyone at %2$@, and they all laughed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al final, %1$@ compartió %3$@ con todos en %2$@, y todos rieron."
          }
        }
      }
    },
    "story.s2.v1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That night, %1$@ dreamed that %2$@ filled up with stars."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa noche, %1$@ soñó que %2$@ se llenaba de estrellas."
          }
        }
      }
    },
    "story.s2.v2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "And so %1$@ learned that the best adventures start with %3$@ and a friend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Y así %1$@ aprendió que las mejores aventuras empiezan con %3$@ y un amigo."
          }
        }
      }
    },
