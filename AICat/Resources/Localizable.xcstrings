    "challenge.s2.c1.goal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Label each card and watch my accuracy meter rise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
