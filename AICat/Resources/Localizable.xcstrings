    "challenge.s2.c1.concept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each label is one piece of data for me."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada etiqueta es un dato para mí."
          }
        }
