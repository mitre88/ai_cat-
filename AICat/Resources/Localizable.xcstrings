    "challenge.s10.c3.concept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every AI needs data, a goal and limits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda IA necesita datos, un objetivo y límites."
          }
        }
