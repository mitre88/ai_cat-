    "challenge.s10.c1.concept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generation follows the prompt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La generación sigue la instrucción."
          }
        }
      }
    },
    "challenge.s10.c1.goal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give me three words and I'll grow a story. Change a word, change the story."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dame tres palabras y haré crecer una historia. Cambia una palabra, cambia la historia."
          }
        }
      }
    },
