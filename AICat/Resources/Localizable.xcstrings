    "challenge.s1.c1.concept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rule tells us what to do. Follow it and I will watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regla nos dice qué hacer. Síguela y yo observo."
          }
        }
      }
    },
    "challenge.s1.c1.goal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put each fruit in the basket of its colour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon cada fruta en la canasta de su color."
          }
        }
      }
    },
    "challenge.s1.c1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Red or green?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Roja o verde?"
          }
        }
      }
    },
    "challenge.s1.c2.concept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learning means finding the pattern from examples."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprender es encontrar el patrón a partir de ejemplos."
          }
        }
      }
    },
    "challenge.s1.c2.goal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody told us the rule. Try, watch the glow, and find the pattern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie nos dijo la regla. Prueba, mira el brillo y descubre el patrón."
          }
        }
      }
    },
    "challenge.s1.c2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The secret pattern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El patrón secreto"
          }
        }
      }
    },
    "challenge.s1.c3.concept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules can combine clues. Harder patterns need more examples."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas pueden combinar pistas. Los patrones difíciles necesitan más ejemplos."
          }
        }
      }
    },
    "challenge.s1.c3.goal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the fruits with BOTH clues go to basket 1."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo las frutas con las DOS pistas van a la canasta 1."
          }
        }
      }
    },
    "challenge.s1.c3.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two clues at once"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos pistas a la vez"
          }
        }
      }
    },
    "challenge.s1.c4.concept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI learns from your examples, so good examples matter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA aprende de tus ejemplos, así que los buenos ejemplos importan."
          }
        }
      }
    },
    "challenge.s1.c4.goal": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More fruits, more clues, fewer hints. Find the pattern and let me finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más frutas, más pistas, menos ayuda. Encuentra el patrón y déjame terminar."
          }
        }
      }
    },
    "challenge.s1.c4.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Master gardener"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Maestro del jardín"
          }
        }
      }
    },
    "challenge.s10.c1.concept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generation follows the prompt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La generación sigue la instrucción."
